@page "/porteria"
@using FrontEnt_GestionPortatiles_Blazor.DTOs.Accesos
@using FrontEnt_GestionPortatiles_Blazor.DTOs.Estudiantes
@using FrontEnt_GestionPortatiles_Blazor.DTOs.Equipos
@using FrontEnt_GestionPortatiles_Blazor.Servicios
@inject IApiService ApiService
@inject IJSRuntime JS

<PageTitle>SGE - Control de Portería</PageTitle>

<div class="porteria-container">
    <!-- Encabezado del Módulo -->
    <header class="porteria-header">
        <h1>Control de Portería</h1>
        <p class="subtitle">Búsqueda rápida y registro de entrada/salida de estudiantes y portátiles (RF-07, RF-08)</p>
    </header>

    <!-- Barra de Búsqueda Acelerada (< 2.0s - RNF-01) -->
    <section class="search-card">
        <form @onsubmit="BuscarEstudiante" class="search-form">
            <div class="search-input-group">
                <span class="search-icon">🔍</span>
                <input type="text" 
                       class="search-input" 
                       placeholder="Ingrese el número de documento del estudiante..." 
                       value="@numeroDocumento" 
                       @oninput="OnInputDocumento" 
                       autofocus />
                <button type="submit" class="btn-search" disabled="@isSearching">
                    @(isSearching ? "Verificando..." : "Buscar")
                </button>
            </div>
        </form>

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger animate-fade mt-3">
                ⚠️ @mensajeError
            </div>
        }
    </section>

    <!-- Perfil y Verificación Visual de Acceso (RF-07, RNF-05) -->
    @if (estudianteEncontrado != null)
    {
        <div class="profile-grid animate-fade">
            <!-- Tarjeta 1: Información Académica y Personal -->
            <div class="card card-student">
                <div class="card-header">
                    <h3>Perfil del Estudiante</h3>
                    <span class="badge @(estudianteEncontrado.Estado == "Activo" ? "badge-success" : "badge-danger")">
                        @estudianteEncontrado.Estado
                    </span>
                </div>
                <div class="card-body">
                    <div class="avatar-wrapper">
                        <img src="@(string.IsNullOrEmpty(estudianteEncontrado.FotoPerfilUrl) ? "images/default-avatar.png" : estudianteEncontrado.FotoPerfilUrl)" 
                             alt="Foto de Perfil" 
                             class="profile-avatar" />
                    </div>
                    <div class="info-list">
                        <div class="info-item">
                            <span class="label">Documento:</span>
                            <span class="value">@estudianteEncontrado.Documento</span>
                        </div>
                        <div class="info-item">
                            <span class="label">Nombre:</span>
                            <span class="value highlight">@estudianteEncontrado.NombreCompleto</span>
                        </div>
                        <div class="info-item">
                            <span class="label">Carrera ID:</span>
                            <span class="value">@estudianteEncontrado.IdCarrera</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tarjeta 2: Datos de Equipos y Accesorios (RF-07) -->
            <div class="card card-equipment">
                <div class="card-header">
                    <h3>Equipo Registrado</h3>
                    <span class="badge @(estudianteEncontrado.TieneEquipoRegistrado ? "badge-info" : "badge-secondary")">
                        @(estudianteEncontrado.TieneEquipoRegistrado ? "Vinculado" : "Sin Equipo")
                    </span>
                </div>
                <div class="card-body">
                    @if (estudianteEncontrado.TieneEquipoRegistrado)
                    {
                        <div class="equipment-preview">
                            <img src="@(string.IsNullOrEmpty(estudianteEncontrado.FotoEquipoUrl) ? "images/default-laptop.png" : estudianteEncontrado.FotoEquipoUrl)" 
                                 alt="Foto del Portátil" 
                                 class="laptop-img" />
                        </div>
                        <div class="info-list">
                            <div class="info-item">
                                <span class="label">Serial:</span>
                                <span class="value serial-code">@estudianteEncontrado.SerialEquipo</span>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(estudianteEncontrado.FotoAccesoriosUrl))
                        {
                            <div class="accesorios-section mt-3">
                                <span class="label-section">Accesorios:</span>
                                <a href="@estudianteEncontrado.FotoAccesoriosUrl" target="_blank" class="link-foto">📷 Foto Accesorios</a>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-equipment">
                            <p>El estudiante no registra dispositivos portátiles vinculados en el sistema.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Tarjeta 3: Botones para Marcación de Tiempos de Acceso (RF-08) -->
            <div class="card card-actions">
                <div class="card-header">
                    <h3>Registro de Movimiento</h3>
                </div>
                <div class="card-body">
                    <p class="action-desc">Presione el botón correspondiente para guardar la marca de tiempo (Timestamp) del estudiante.</p>

                    <div class="action-buttons">
                        <button class="btn-action btn-entry" 
                                @onclick='() => RegistrarAcceso("Entrada")' 
                                disabled="@isProcessing">
                            🟢 Registrar ENTRADA
                        </button>
                        <button class="btn-action btn-exit" 
                                @onclick='() => RegistrarAcceso("Salida")' 
                                disabled="@isProcessing">
                            🔴 Registrar SALIDA
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(mensajeExito))
                    {
                        <div class="alert alert-success animate-fade mt-3">
                            ✅ @mensajeExito
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string numeroDocumento = string.Empty;
    private string mensajeError = string.Empty;
    private string mensajeExito = string.Empty;
    private bool isSearching = false;
    private bool isProcessing = false;

    private EstudianteDetalleDto? estudianteEncontrado;

    // Reactividad en tiempo real: Si el usuario borra o modifica el documento, se ocultan las tarjetas
    private void OnInputDocumento(ChangeEventArgs e)
    {
        numeroDocumento = e.Value?.ToString() ?? string.Empty;

        if (estudianteEncontrado != null && estudianteEncontrado.Documento != numeroDocumento)
        {
            estudianteEncontrado = null;
            mensajeError = string.Empty;
            mensajeExito = string.Empty;
        }
    }

    private async Task BuscarEstudiante()
    {
        mensajeError = string.Empty;
        mensajeExito = string.Empty;

        if (string.IsNullOrWhiteSpace(numeroDocumento))
        {
            mensajeError = "Por favor ingrese un número de documento válido.";
            estudianteEncontrado = null;
            return;
        }

        isSearching = true;
        try
        {
            // Apunta al endpoint directo habilitado para portería: GET /api/Estudiantes/buscar/{documento}
            estudianteEncontrado = await ApiService.ConsultarEstudiantePorDocumentoAsync(numeroDocumento.Trim());

            if (estudianteEncontrado == null)
            {
                mensajeError = "No se encontró ningún estudiante con el documento ingresado.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al consultar los datos: {ex.Message}";
        }
        finally
        {
            isSearching = false;
        }
    }

    private async Task RegistrarAcceso(string tipoMovimiento)
    {
        if (estudianteEncontrado == null) return;

        isProcessing = true;
        mensajeExito = string.Empty;
        mensajeError = string.Empty;

        var dto = new RegistroAccesoCreateDto
        {
            IdEstudiante = estudianteEncontrado.IdEstudiante,
            IdEquipo = null,
            IdPorteria = 1,
            TipoMovimiento = tipoMovimiento
        };

        try
        {
            bool exito = await ApiService.RegistrarAccesoAsync(dto);

            if (exito)
            {
                mensajeExito = $"¡Movimiento de {tipoMovimiento.ToUpper()} registrado con éxito!";
            }
            else
            {
                mensajeError = "No se pudo completar el registro del movimiento.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al procesar el registro: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }
}