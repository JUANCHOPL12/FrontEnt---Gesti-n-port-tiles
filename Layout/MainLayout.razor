@inherits LayoutComponentBase
@using Blazored.LocalStorage
@inject ILocalStorageService LocalStorage
@inject NavigationManager Navigation

<div class="page">
    @if (estaAutenticado)
    {
        <!-- Muestra la Navbar verde institucional solo cuando el usuario ya inició sesión -->
        <NavMenu />
    }

    <main>
        <article class="content">
            @Body
        </article>
    </main>
</div>

@code {
    private bool estaAutenticado = false;

    protected override async Task OnParametersSetAsync()
    {
        // Verificar si existe una sesión activa almacenada (RF-01, RNF-08)
        var token = await LocalStorage.GetItemAsync<string>("sge_token");
        estaAutenticado = !string.IsNullOrEmpty(token);
    }
}