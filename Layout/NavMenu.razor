@using Blazored.LocalStorage
@inject ILocalStorageService LocalStorage
@inject NavigationManager Navigation

<nav class="navbar navbar-expand-lg sge-navbar shadow-sm px-4">
    <div class="container-fluid">
        
        <!-- 1. EXTREMO IZQUIERDO: CONTENEDOR RESERVADO PARA TU LOGO INSTITUCIONAL -->
        <a class="navbar-brand me-4" href="porteria">
            <div class="sge-logo-container">
                <!-- Espacio listo para colocar la ruta de tu logo -->
                <img src="images/logo-uniciencia.png" 
                     alt="Logo Uniciencia" 
                     class="sge-logo-img" 
                     onerror="this.style.display='none'; document.getElementById('logo-placeholder').style.display='flex';" />

                <!-- Placeholder visual temporal mientras cargas tu imagen -->
                <div id="logo-placeholder" class="bg-light text-success fw-bold rounded px-2 py-1 fs-5 align-items-center" style="display: none; height: 40px;">
                    UC
                </div>

                <div class="sge-divider"></div>

                <div class="sge-subtitle fw-bold">
                    UNICIENCIA<br />
                    <span style="font-weight: 300; font-size: 0.65rem;">Corporación Unificada Nacional de Educación Superior</span>
                </div>
            </div>
        </a>

        <!-- BOTÓN DE COLAPSO RESPONSIVE (RNF-05) -->
        <button class="navbar-toggler text-white border-white" type="button" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="@NavMenuCssClass navbar-collapse justify-content-between">
            
            <!-- 2. CENTRO: OPCIONES DE MENÚ CON ÍCONOS Y LÍNEA ACTIVA -->
            <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-2">
                @if (!string.IsNullOrEmpty(rolUsuario))
                {
                    <!-- INICIO / PORTERÍA (Guardia, Administrador, SuperAdmin) (RF-07, RF-08) -->
                    <li class="nav-item">
                        <NavLink class="nav-link sge-nav-link" href="porteria" Match="NavLinkMatch.Prefix">
                            <i class="bi bi-house-door fs-5"></i> <span>Inicio</span>
                        </NavLink>
                    </li>

                    <!-- PORTÁTILES Y ESTUDIANTES (Administrador, SuperAdmin) (RF-05, RF-06, RF-09) -->
                    @if (rolUsuario == "Administrador" || rolUsuario == "SuperAdmin")
                    {
                        <li class="nav-item">
                            <NavLink class="nav-link sge-nav-link" href="estudiantes" Match="NavLinkMatch.Prefix">
                                <i class="bi bi-laptop fs-5"></i> <span>Portátiles</span>
                            </NavLink>
                        </li>
                    }

                    <!-- USUARIOS DEL SISTEMA (Exclusivo SuperAdmin) (RF-10) -->
                    @if (rolUsuario == "SuperAdmin")
                    {
                        <li class="nav-item">
                            <NavLink class="nav-link sge-nav-link" href="usuarios" Match="NavLinkMatch.Prefix">
                                <i class="bi bi-people fs-5"></i> <span>Usuarios</span>
                            </NavLink>
                        </li>
                    }

                    <!-- REPORTES E HISTORIAL DE ACCESOS (RF-08) -->
                    <li class="nav-item">
                        <NavLink class="nav-link sge-nav-link" href="reportes" Match="NavLinkMatch.Prefix">
                            <i class="bi bi-file-earmark-text fs-5"></i> <span>Reportes</span>
                        </NavLink>
                    </li>
                }
            </ul>

            <!-- 3. EXTREMO DERECHO: PERFIL DE USUARIO Y DROPDOWN (RF-02, RNF-08) -->
            <div class="d-flex align-items-center">
                @if (!string.IsNullOrEmpty(nombreUsuario))
                {
                    <div class="dropdown">
                        <a class="d-flex align-items-center gap-2 sge-dropdown-toggle dropdown-toggle" href="#" role="button" @onclick="ToggleDropdown" @onclick:preventDefault>
                            <div class="sge-user-avatar">
                                <i class="bi bi-person-circle"></i>
                            </div>
                            <span class="d-none d-md-inline">@rolUsuario</span>
                        </a>

                        <ul class="dropdown-menu dropdown-menu-end shadow mt-2 @(showDropdown ? "show" : "")" style="position: absolute;">
                            <li><h6 class="dropdown-header">@nombreUsuario</h6></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <button class="dropdown-item text-danger fw-bold" @onclick="CerrarSesion">
                                    <i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión
                                </button>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <NavLink class="btn btn-outline-light btn-sm fw-bold" href="login">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                    </NavLink>
                }
            </div>

        </div>
    </div>
</nav>

@code {
    private bool collapseNavMenu = true;
    private bool showDropdown = false;
    private string? rolUsuario;
    private string? nombreUsuario;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    protected override async Task OnInitializedAsync()
    {
        // Leer la sesión persistida desde LocalStorage (RF-01, RNF-08)
        rolUsuario = await LocalStorage.GetItemAsync<string>("sge_rol");
        nombreUsuario = await LocalStorage.GetItemAsync<string>("sge_usuario");
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void ToggleDropdown()
    {
        showDropdown = !showDropdown;
    }

    private async Task CerrarSesion()
    {
        // Destruir credenciales de sesión activa (RF-02)
        await LocalStorage.RemoveItemAsync("sge_token");
        await LocalStorage.RemoveItemAsync("sge_rol");
        await LocalStorage.RemoveItemAsync("sge_usuario");
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}