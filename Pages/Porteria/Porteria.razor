@page "/porteria"
@using FrontEnt_GestionPortatiles_Blazor.DTOs.Accesos
@using FrontEnt_GestionPortatiles_Blazor.DTOs.Equipos
@inject HttpClient Http
@inject IJSRuntime JS

<PageTitle>SGE - Control de Portería</PageTitle>

<div class="porteria-container">
    <!-- Encabezado del Módulo -->
    <header class="porteria-header">
        <h1>Control de Portería</h1>
        <p class="subtitle">Búsqueda rápida y registro de entrada/salida de estudiantes y portátiles</p>
    </header>

    <!-- Barra de Búsqueda Rápida (RF-07, RNF-01) -->
    <section class="search-card">
        <form @onsubmit="BuscarEstudiante" class="search-form">
            <div class="search-input-group">
                <span class="search-icon">🔍</span>
                <input type="text" 
                       class="search-input" 
                       placeholder="Ingrese el número de documento del estudiante..." 
                       @bind="numeroDocumento" 
                       @bind:event="oninput" 
                       autofocus />
                <button type="submit" class="btn-search" disabled="@isSearching">
                    @(isSearching ? "Verificando..." : "Buscar")
                </button>
            </div>
        </form>

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger animate-fade mt-3">
                ⚠️ @mensajeError
            </div>
        }
    </section>

    <!-- Perfil y Verificación Visual de Acceso (RF-07, RNF-05) -->
    @if (estudianteEncontrado != null)
    {
        <div class="profile-grid animate-fade">
            <!-- Tarjeta 1: Información Académica y Personal -->
            <div class="card card-student">
                <div class="card-header">
                    <h3>Perfil del Estudiante</h3>
                    <span class="badge @(estudianteEncontrado.Estado == "Activo" ? "badge-success" : "badge-danger")">
                        @estudianteEncontrado.Estado
                    </span>
                </div>
                <div class="card-body">
                    <div class="avatar-wrapper">
                        <img src="@(string.IsNullOrEmpty(estudianteEncontrado.FotoPerfilUrl) ? "images/default-avatar.png" : estudianteEncontrado.FotoPerfilUrl)" 
                             alt="Foto de Perfil" 
                             class="profile-avatar" />
                    </div>
                    <div class="info-list">
                        <div class="info-item">
                            <span class="label">Documento:</span>
                            <span class="value">@estudianteEncontrado.NumeroDocumento</span>
                        </div>
                        <div class="info-item">
                            <span class="label">Nombre:</span>
                            <span class="value highlight">@estudianteEncontrado.NombreCompleto</span>
                        </div>
                        <div class="info-item">
                            <span class="label">Carrera:</span>
                            <span class="value">@estudianteEncontrado.Carrera</span>
                        </div>
                        <div class="info-item">
                            <span class="label">Facultad:</span>
                            <span class="value">@estudianteEncontrado.Facultad</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tarjeta 2: Datos de Equipos y Accesorios (RF-07) -->
            <div class="card card-equipment">
                <div class="card-header">
                    <h3>Equipo Registrado</h3>
                    <span class="badge @(estudianteEncontrado.Equipo != null ? "badge-info" : "badge-secondary")">
                        @(estudianteEncontrado.Equipo != null ? "Vinculado" : "Sin Equipo")
                    </span>
                </div>
                <div class="card-body">
                    @if (estudianteEncontrado.Equipo != null)
                    {
                        <div class="equipment-preview">
                            <img src="@(string.IsNullOrEmpty(estudianteEncontrado.Equipo.FotoEquipoUrl) ? "images/default-laptop.png" : estudianteEncontrado.Equipo.FotoEquipoUrl)" 
                                 alt="Foto del Portátil" 
                                 class="laptop-img" />
                        </div>
                        <div class="info-list">
                            <div class="info-item">
                                <span class="label">Tipo / Marca:</span>
                                <span class="value">@estudianteEncontrado.Equipo.Tipo - @estudianteEncontrado.Equipo.Marca</span>
                            </div>
                            <div class="info-item">
                                <span class="label">Serial:</span>
                                <span class="value serial-code">@estudianteEncontrado.Equipo.Serial</span>
                            </div>
                        </div>

                        <!-- Detalle de Accesorios -->
                        @if (estudianteEncontrado.Equipo.Accesorios != null && estudianteEncontrado.Equipo.Accesorios.Any())
                        {
                            <div class="accesorios-section mt-3">
                                <span class="label-section">Accesorios:</span>
                                <ul class="accesorios-list">
                                    @foreach (var acc in estudianteEncontrado.Equipo.Accesorios)
                                    {
                                        <li>
                                            <span>🔹 @acc.DescripcionAccesorio</span>
                                            @if (!string.IsNullOrEmpty(acc.FotoAccesoriosUrl))
                                            {
                                                <a href="@acc.FotoAccesoriosUrl" target="_blank" class="link-foto">📷 Foto</a>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-equipment">
                            <p>El estudiante no registra dispositivos portátiles vinculados en el sistema.</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Tarjeta 3: Botones para Marcación de Tiempos de Acceso (RF-08) -->
            <div class="card card-actions">
                <div class="card-header">
                    <h3>Registro de Movimiento</h3>
                </div>
                <div class="card-body">
                    <p class="action-desc">Presione el botón correspondiente para guardar la marca de tiempo (Timestamp) del estudiante.</p>

                    <div class="action-buttons">
                        <button class="btn-action btn-entry" 
                                @onclick='() => RegistrarAcceso("Entrada")' 
                                disabled="@isProcessing">
                            🟢 Registrar ENTRADA
                        </button>
                        <button class="btn-action btn-exit" 
                                @onclick='() => RegistrarAcceso("Salida")' 
                                disabled="@isProcessing">
                            🔴 Registrar SALIDA
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(mensajeExito))
                    {
                        <div class="alert alert-success animate-fade mt-3">
                            ✅ @mensajeExito
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private string numeroDocumento = string.Empty;
    private string mensajeError = string.Empty;
    private string mensajeExito = string.Empty;
    private bool isSearching = false;
    private bool isProcessing = false;

    private EstudianteVerificacionReadDto? estudianteEncontrado;

    private async Task BuscarEstudiante()
    {
        mensajeError = string.Empty;
        mensajeExito = string.Empty;

        if (string.IsNullOrWhiteSpace(numeroDocumento))
        {
            mensajeError = "Por favor ingrese un número de documento válido.";
            return;
        }

        isSearching = true;
        try
        {
            // GET /api/RegistroAccesos/verificar/{numeroDocumento} (RF-07)
            var response = await Http.GetAsync($"api/RegistroAccesos/verificar/{numeroDocumento}");

            if (response.IsSuccessStatusCode)
            {
                estudianteEncontrado = await response.Content.ReadFromJsonAsync<EstudianteVerificacionReadDto>();
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                estudianteEncontrado = null;
                mensajeError = "No se encontró ningún estudiante con el documento ingresado.";
            }
            else
            {
                mensajeError = "Ocurrió un error al consultar los datos. Intente nuevamente.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error de comunicación con el backend: {ex.Message}";
        }
        finally
        {
            isSearching = false;
        }
    }

    private async Task RegistrarAcceso(string tipoMovimiento)
    {
        if (estudianteEncontrado == null) return;

        isProcessing = true;
        mensajeExito = string.Empty;
        mensajeError = string.Empty;

        var dto = new RegistroAccesoCreateDto
        {
            IdEstudiante = estudianteEncontrado.IdEstudiante,
            IdEquipo = estudianteEncontrado.Equipo?.IdEquipo,
            IdPorteria = 1, // ID por defecto de la portería activa
            TipoMovimiento = tipoMovimiento
        };

        try
        {
            // POST /api/RegistroAccesos (RF-08)
            var response = await Http.PostAsJsonAsync("api/RegistroAccesos", dto);

            if (response.IsSuccessStatusCode)
            {
                mensajeExito = $"¡Movimiento de {tipoMovimiento.ToUpper()} registrado con éxito!";
            }
            else
            {
                mensajeError = "No se pudo completar el registro del movimiento.";
            }
        }
        catch (Exception ex)
        {
            mensajeError = $"Error al procesar el registro: {ex.Message}";
        }
        finally
        {
            isProcessing = false;
        }
    }

    // DTO de respuesta estructurado para la verificación en portería
    public class EstudianteVerificacionReadDto
    {
        public int IdEstudiante { get; set; }
        public string NumeroDocumento { get; set; } = string.Empty;
        public string NombreCompleto { get; set; } = string.Empty;
        public string Carrera { get; set; } = string.Empty;
        public string Facultad { get; set; } = string.Empty;
        public string Estado { get; set; } = string.Empty;
        public string? FotoPerfilUrl { get; set; }
        public EquipoReadDto? Equipo { get; set; }
    }
}